<Project Sdk="Godot.NET.Sdk/4.5.2">
  <!--
    Procedural Pixel Creature Workshop
    Godot .NET 4.5.2 / C# / .NET 8. The framework itself lives in
    addons/procedural_creatures (Core = engine independent, Runtime = Godot layer).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>PixelCreatures</RootNamespace>
    <AssemblyName>ProceduralPixelCreatures</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
    <NoWarn>$(NoWarn);CA1050</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The pixel renderer is CPU bound: optimize also when running from the editor (Debug), so that
       in-editor play and the self-test show representative performance. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console harness is a separate project that compiles the engine independent core on its own. -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Compile Remove="docs/**;build/**;reports/**;out/**" />
  </ItemGroup>
</Project>
