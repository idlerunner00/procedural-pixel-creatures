; Engine configuration file.
; Procedural Pixel Creature Workshop - Godot .NET 4.5.2 (C#, .NET 8)

config_version=5

[application]

config/name="Procedural Pixel Creature Workshop"
config/description="Procedural pixel-art creatures, animation, genetics workshop and living terrain. Built with Godot .NET."
config/version="1.0.0"
run/main_scene="res://workshop/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"
run/max_fps=0
boot_splash/bg_color=Color(0.086, 0.094, 0.118, 1)
boot_splash/show_image=false

[debug]

gdscript/warnings/enable=false
settings/stdout/print_fps=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=940
window/size/resizable=true
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="ProceduralPixelCreatures"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

